rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.role == 'admin'; }
    function isEditor() {
      return signedIn() && request.auth.token.role in ['editor', 'admin'];
    }

    match /cards/{cardId} {
      allow read: if resource.data.status == 'published' || isEditor();
      allow create, update: if isEditor()
        && cardId == request.resource.data.slug
        && request.resource.data.status in ['draft', 'review', 'published', 'archived']
        && request.resource.data.displayOrder is int;
      allow delete: if isAdmin();
    }

    match /stories/{storyId} {
      allow read: if resource.data.status == 'published' || isEditor();
      allow create, update: if isEditor()
        && storyId == request.resource.data.slug
        && request.resource.data.status in ['draft', 'review', 'published', 'archived'];
      allow delete: if isAdmin();
    }

    match /externalSources/{sourceId} {
      allow read: if resource.data.status == 'published' || isEditor();
      allow create, update: if isEditor()
        && sourceId == request.resource.data.slug
        && request.resource.data.status in ['draft', 'review', 'published', 'archived'];
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    // Dữ liệu tiền và nhật ký chỉ được ghi từ backend tin cậy/Admin SDK.
    match /orders/{document=**} { allow read, write: if false; }
    match /paymentEvents/{document=**} { allow read, write: if false; }
    match /auditLogs/{document=**} { allow read, write: if false; }

    match /{document=**} { allow read, write: if false; }
  }
}
