{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "strict": false,
    "strictNullChecks": true
  },
  "include": [
    "scripts/build.js",
    "scripts/lib/**/*.js"
  ]
}
