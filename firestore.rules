rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isOwner() {
      return isAdmin() && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'owner';
    }

    match /cards/{slug} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
    }
    match /posts/{slug} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
    }
    match /settings/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }
    match /media/{mediaId} {
      allow read, write: if isAdmin();
    }
    match /subscribers/{subscriberId} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'source', 'note', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.source is string
        && request.resource.data.source.size() <= 80
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && request.resource.data.createdAt is timestamp;
      allow read, update, delete: if isAdmin();
    }
    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOwner());
      allow create, update, delete: if isOwner();
    }
  }
}
